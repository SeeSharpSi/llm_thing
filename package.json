{
  "name": "llm_thing",
  "author": "SilasT",
  "version": "0.0.1",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run test:js && npm run test:c",
    "test:js": "node --test tests/js/*.test.js",
    "test:c": "sh tests/c/run.sh",
    "test:bundle": "node --test tests/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/js/*.test.js"
  },
  "dependencies": {
    "@rebble/clay": "1.0.10"
  },
  "pebble": {
    "displayName": "LLM Thing",
    "uuid": "cfee9469-e9db-4f5b-a219-b4d438d35f17",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "RequestId",
      "RequestText",
      "ResponseChunk",
      "ResponseChunkIndex",
      "ResponseDone",
      "ResponseError",
      "ResponseReset",
      "ProgressText",
      "ProgressReset",
      "ProgressAppend",
      "Endpoint",
      "ApiKey",
      "Model",
      "SystemPrompt",
      "ShowThinking",
      "ShowInputContextSize",
      "ShowOutputContextSize",
      "WebSearchEnabled",
      "GeolocationToolEnabled",
      "TimelineToolEnabled",
      "MaxToolCalls",
      "ApiMode",
      "MaxOutputTokens",
      "ReasoningEffort",
      "FontSize",
      "McpServersJson",
      "BuzzStrength",
      "ProgressDetail",
      "ProgressHistory",
      "ProgressInputContextSize",
      "ProgressOutputContextSize",
      "ChatReset",
      "PreserveChats",
      "ConfigAction",
      "PastChatsRequest",
      "PastChatsReset",
      "PastChatsItemId",
      "PastChatsItemTitle",
      "PastChatsDone",
      "PastChatsError",
      "PastChatLoad",
      "PastChatDelete",
      "PastChatDeleted",
      "PastChatTextReset",
      "PastChatTextChunk",
      "PastChatTextDone",
      "StartDictationQuickLaunch",
      "ScrollLines",
      "TextColor",
      "BackgroundColor",
      "PromptBackgroundColor",
      "BoldTextColor",
      "HealthToolEnabled",
      "HealthSummaryRequest",
      "HealthSummaryJson",
      "HealthSummaryError",
      "HealthStartUnix",
      "HealthEndUnix",
      "HealthQueryMask",
      "HealthAverageScope",
      "HealthSessionOffset",
      "TouchScrollEnabled",
      "RequestTimeoutMs",
      "PebbleMemoryToolEnabled",
      "MemoriesJson",
      "SpeakerFeedbackEnabled",
      "RequestCancel",
      "RequestRetry",
      "RetryAvailable"
    ],
    "resources": {
      "media": [
        {
          "name": "SOUND_HERDR_DONE",
          "file": "audio/herdr_done.pcm",
          "type": "raw",
          "targetPlatforms": [
            "emery",
            "flint"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
